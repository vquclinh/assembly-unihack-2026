# Wallet that pays gas for every user action (the relayer). Needs a little Fuji AVAX.
# It can be the same wallet you deployed with: copy PRIVATE_KEY from contracts/.env
# The same wallet receives the x402 payments for AI reports.
RELAYER_PRIVATE_KEY=

# ---------------------------------------------------------------- AI damage reports (x402)
# OpenRouter key from https://openrouter.ai/keys. Without it the AI card says "not configured".
OPENROUTER_API_KEY=
# Any OpenRouter vision model. The cheap default is fine for development;
# for the demo video, switch to a stronger vision model (for example Qwen2.5 VL 72B);
# copy its exact id from https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Price of one AI report in test USDC, paid by the mediator over x402.
AI_REPORT_PRICE_USDC=0.10
# Test only: 1 returns a labelled fake report without calling OpenRouter. Leave empty.
AI_MOCK=

# ---------------------------------------------------------------- storage
# Vercel Blob token. When set, photos, reports and records survive redeploys.
# On Vercel: Storage > Create > Blob, then connect it to the project (the token is added for you).
BLOB_READ_WRITE_TOKEN=
# Local folder used when there is no Blob token. Defaults to ./.data (or /tmp/coc-data on Vercel).
DATA_DIR=

# ---------------------------------------------------------------- keeper
# Protects GET /api/keeper (the daily Vercel cron sends it as a Bearer token).
# Any long random string. Leave empty to allow anyone to trigger the sweep, which is harmless.
CRON_SECRET=

# ---------------------------------------------------------------- network
# Optional RPC for the server and the browser proxy (/api/rpc). Defaults to the public Fuji RPC.
# A private endpoint (for example from Infura or Chainstack) avoids public rate limits.
RPC_URL=

# Display-only exchange rate used to show deposits in VND.
NEXT_PUBLIC_VND_PER_USDC=26000
