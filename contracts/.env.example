# Private key of the deployer wallet (Fuji testnet only, never a wallet holding real money)
PRIVATE_KEY=
# Optional: custom RPC
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Token used for deposits. Leave empty to deploy a public-mint test USDC.
# Circle's official test USDC on Fuji: 0x5425890298aed601595a70AB815c96711a31Bc65
USDC_ADDRESS=
# Default timeouts in seconds, used only by createOffer(). The web app always sends its own
# per-lease windows (createOfferWithWindows), e.g. 2 minutes for the demo, 3 days for real use.
RESPONSE_WINDOW=259200
MEDIATION_TIMEOUT=604800
# Trusted landlord badge (npm run deploy-badge:fuji): leases a landlord must complete first.
# 1 keeps the demo short; use 3 or more for a real launch.
BADGE_MIN_COMPLETED=1
# Minimum deposit-seconds held (USDC base units x seconds). 0 for the demo.
BADGE_MIN_VALUE_SECONDS=0
